{
  "name": "cloud-director-mcp",
  "version": "0.1.1",
  "description": "MCP server for VMware Cloud Director API integration",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "cloud-director-mcp": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', 0o755)\"",
    "dev": "tsx src/index.ts",
    "start": "node build/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vmware",
    "cloud-director",
    "vcd"
  ],
  "author": "elix-project",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "axios": "^1.6.0",
    "dotenv": "^16.5.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/xml2js": "^0.4.14",
    "tsx": "^4.0.0",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elix-project/cloud-director-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/elix-project/cloud-director-mcp/issues"
  },
  "homepage": "https://github.com/elix-project/cloud-director-mcp#readme"
}
